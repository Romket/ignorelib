{
    "configurations": [
    {
        "presentation": { "hidden": true },
        "name": "(ctest) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${cmake.testProgram}",
        "args": [ "${cmake.testArgs}"],
        "stopAtEntry": true,
        "cwd": "${cmake.testWorkingDirectory}",
        "environment": [],
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    }
    ],
}
